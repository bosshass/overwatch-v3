# Frontend (must exist at BUILD time — Vite inlines these)
# supabaseClient.js throws on load if these are missing. That is deliberate:
# v9's hardcoded fallback pointed at DRH production.
VITE_SUPABASE_URL=https://wppwofsbwymzaeyapwhs.supabase.co
VITE_SUPABASE_ANON_KEY=your-v3-anon-key-here
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Serverless only (api/send-sms.js). NOT prefixed VITE_ — these must never
# reach the browser bundle.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=MG...
# TWILIO_FROM_NUMBER is only used when no Messaging Service SID is set.
TWILIO_FROM_NUMBER=+1
# Optional. Defaults to drhsecurityservices.com,jnbservice.com
SMS_ALLOWED_DOMAINS=
